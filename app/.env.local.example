# ── Network ────────────────────────────────────────────────────────────────
# RPC the browser + scripts talk to. Local surfnet by default; point at a devnet/mainnet
# provider (e.g. QuickNode) for a real deployment.
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
# Wallet Standard chain the wallet signs for. Surfnet forks mainnet, so keep solana:mainnet for
# local; use solana:devnet / solana:mainnet to match a real deployment.
NEXT_PUBLIC_WALLET_CHAIN=solana:mainnet
# Cluster label shown in the UI (localnet | devnet | mainnet).
NEXT_PUBLIC_CLUSTER=localnet
# fbyt_vault program id (the reconstruction's declared id; the local deploy uses it).
NEXT_PUBLIC_FBYT_PROGRAM_ID=3yw2g3VUUGy5vsgBgPaGomxQ95hwEhKprxbeeLhpza5Y

# ── Auth ───────────────────────────────────────────────────────────────────
# HMAC secret for the SIWS session cookie. CHANGE THIS in any real deployment.
SESSION_SECRET=dev-only-secret-change-me

# ── Monitoring (optional) ──────────────────────────────────────────────────
# Google Analytics measurement id — when set, the analytics tag is injected.
NEXT_PUBLIC_GA_ID=
# Sentry DSN — when set, wire @sentry/nextjs in a production build (see app/README.md).
NEXT_PUBLIC_SENTRY_DSN=
