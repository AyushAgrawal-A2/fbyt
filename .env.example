# Copy to .env next to docker-compose.yml and fill in. See DEPLOY.md.

# App (NEXT_PUBLIC_* are inlined at build time — rebuild the app image after changing)
SESSION_SECRET=change-me-to-a-long-random-secret
NEXT_PUBLIC_SOLANA_RPC_URL=https://your-provider.example/rpc
NEXT_PUBLIC_WALLET_CHAIN=solana:mainnet
NEXT_PUBLIC_CLUSTER=mainnet
NEXT_PUBLIC_FBYT_PROGRAM_ID=DNgg2FmwchUHYx2QiZ9pNJn1q5zypMprkSWFLUnNDigm

# Optional monitoring / RPC failover
SENTRY_DSN=
SOLANA_RPC_URL_FALLBACK=

# Keeper
SOLANA_RPC_URL=https://your-provider.example/rpc
KEEPER_DELEGATE_KEYPAIR=/absolute/path/to/delegate.json
